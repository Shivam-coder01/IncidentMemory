# IncidentMemory — Environment Configuration Template

# Application Server
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Application State Database (SQLite default)
DATABASE_URL=sqlite:///./incident_memory.db

# Hindsight Memory Configuration (Mandatory Persistent Memory)
HINDSIGHT_API_URL=http://localhost:8888
HINDSIGHT_BANK_ID=incident-memory-bank
HINDSIGHT_API_KEY=

# LLM Provider Configuration (groq, openai, gemini)
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=your_llm_api_key_here

# Optional Alternative Providers
# OPENAI_API_KEY=your_openai_key
# GEMINI_API_KEY=your_gemini_key
